# ── Plug-and-play LLM config ───────────────────────────────────────────────
# Retrieval, embeddings and indexing ALWAYS run locally. Only text generation
# uses this provider. Change these two lines to switch models; nothing else
# in the codebase changes.

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_key_from_https://console.groq.com/keys

# ── Other providers (uncomment one, comment the block above) ───────────────

# Google Gemini free tier
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

# Fully offline — no key, no network at all
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434

# OpenRouter free tier
# LLM_PROVIDER=openrouter
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=...

# ── Free-tier token thrift (Groq caps at 8,000 tokens/minute) ──────────────
# Older tool results are abbreviated once the model has acted on them.
# LLM_KEEP_FULL_TOOL_RESULTS=3
# LLM_OLD_TOOL_RESULT_CHARS=400
